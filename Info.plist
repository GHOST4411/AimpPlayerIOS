<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AIMP Player</string>
	<key>CFBundleIdentifier</key>
	<string>com.personal.AimpPlayerIOS</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	
	<!-- Habilita reproducción de música en segundo plano y con pantalla apagada -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	
	<!-- Hace que la carpeta de la app aparezca directamente en la app "Archivos" de iOS -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
